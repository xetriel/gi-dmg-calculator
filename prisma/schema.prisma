// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // Connection URL lives in prisma.config.ts (datasource.url) per Prisma 7 —
  // it must NOT be set here or CLI schema ops (validate/migrate) error P1012.
}

model Build {
  id          String     @id @default(cuid())
  name        String
  characterId String
  data        Json
  enemy       Json
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  rotations   Rotation[]

  @@index([characterId])
}

model Rotation {
  id        String   @id @default(cuid())
  name      String
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  steps     Json
  totalTime Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildId])
}

// One row per export/download event. Powers the /history page (review past
// downloads, compare how outputs evolved). `snapshot` is the reloadable calculator
// payload; `summary` holds precomputed headline numbers so the page never re-runs
// the engine. The format column also serves later usage-analytics aggregation.
model ExportLog {
  id          String   @id @default(cuid())
  characterId String // registry id, e.g. "arlecchino"
  format      String // "json" | "csv" | "txt" | "pdf" | "png"
  label       String // active build name (default "Scratchpad")
  snapshot    Json // { instances, rotations, activeRotationId }
  summary     Json // { setupCount, topHeadline, setups: [{ label, headline }] }
  createdAt   DateTime @default(now())

  @@index([characterId, createdAt])
}

// Per-talent-level multiplier tables. One row per (character, talent, hit, level).
// Seeded from src/data/talents/*.ts; the calculator looks these up when a level is
// selected so the user picks a level instead of typing the multiplier.
model TalentScaling {
  id          String @id @default(cuid())
  characterId String // e.g. "neuvillette"
  talentType  String // "normal" | "skill" | "burst"
  hitKey      String // stable id joined to registry TalentHit.key
  level       Int // 1..N
  value       Float // multiplier percent, e.g. 98.24
  kind        String @default("damage") // "damage" | "buff" | "heal"

  @@unique([characterId, talentType, hitKey, level])
  @@index([characterId])
}
