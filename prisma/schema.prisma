// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Build {
  id          String     @id @default(cuid())
  name        String
  characterId String
  data        Json
  enemy       Json
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  rotations   Rotation[]

  @@index([characterId])
}

model Rotation {
  id        String   @id @default(cuid())
  name      String
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  steps     Json
  totalTime Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildId])
}

// Per-talent-level multiplier tables. One row per (character, talent, hit, level).
// Seeded from src/data/talents/*.ts; the calculator looks these up when a level is
// selected so the user picks a level instead of typing the multiplier.
model TalentScaling {
  id          String @id @default(cuid())
  characterId String // e.g. "neuvillette"
  talentType  String // "normal" | "skill" | "burst"
  hitKey      String // stable id joined to registry TalentHit.key
  level       Int // 1..N
  value       Float // multiplier percent, e.g. 98.24
  kind        String @default("damage") // "damage" | "buff" | "heal"

  @@unique([characterId, talentType, hitKey, level])
  @@index([characterId])
}
