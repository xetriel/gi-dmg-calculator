# MariaDB/MySQL database connection URL
# Customize the credentials and host/port as needed for your local environment.
# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL="mysql://USER@localhost:PORT/DATABASE"
DATABASE_URL="mysql://root:password@localhost:3306/gi_calc"

# Gemini API Key for image scanning features (using Gemini 2.5 Flash)
GEMINI_API_KEY="your_api_key_here"

